# Read by docker compose as .env: cp .env.example .env
# Empty variables fall back to the defaults in docker-compose.yml.

POSTGRES_PASSWORD=123

# Random key, at least 32 characters (e.g. openssl rand -base64 48)
JWT_SECRET=

# https://www.pexels.com/api/ — if empty, category images are not fetched
PEXELS_API_KEY=
