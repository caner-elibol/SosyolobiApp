# docker compose bu dosyayı .env adıyla okur: cp .env.example .env
# Boş bırakılan değişkenler docker-compose.yml içindeki varsayılanlara düşer.

POSTGRES_PASSWORD=123

# En az 32 karakterlik rastgele bir anahtar (örn: openssl rand -base64 48)
JWT_SECRET=

# https://www.pexels.com/api/ — boşsa kategori görselleri çekilmez
PEXELS_API_KEY=
